# --- GOOGLE CLOUD CONFIGURATION ---
GOOGLE_CLOUD_PROJECT=<PROJECT NAME>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=<GCLOUD BUCKET>

# --- AGENT RUNTIME SETTINGS ---
# Use 1 for standard reasoning engines; increase only if handling high concurrency
NUM_WORKERS=1
AGENT_NAME=<AGENT NAME>

# --- AUTHENTICATION (LOCAL ONLY) ---
# Path to your Service Account JSON if running outside of gcloud authenticated shell
# GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# --- ADK STABLE SETTINGS ---
# Force the library to use Vertex AI instead of Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=TRUE